{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AgriciDaniel/claude-blog-brain/schemas/geo-citation-audit-input.schema.json",
  "title": "GEO Citation Audit Input",
  "description": "A passage-level AI citation readiness audit consumed by Claude Blog Brain GEO adapters.",
  "type": "object",
  "required": ["audit_name", "url", "title", "locale", "target_queries", "passages", "page_signals"],
  "properties": {
    "audit_name": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "title": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "target_queries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "heading", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "heading": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "entities": {"type": "array", "items": {"type": "string"}},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url", "retrieved"],
              "additionalProperties": false,
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
                "published": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
              }
            }
          }
        }
      }
    },
    "page_signals": {
      "type": "object",
      "required": ["has_article_schema", "indexable", "preview_allowed", "has_visible_author", "has_modified_date"],
      "additionalProperties": false,
      "properties": {
        "has_article_schema": {"type": "boolean"},
        "indexable": {"type": "boolean"},
        "preview_allowed": {"type": "boolean"},
        "has_visible_author": {"type": "boolean"},
        "has_modified_date": {"type": "boolean"}
      }
    },
    "llms_txt_strategy": {"type": "string", "enum": ["none", "present", "planned", "unknown"]},
    "source_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
