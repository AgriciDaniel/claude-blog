{
  "version": 1,
  "status": "market-ready",
  "domain": "blog content creation, optimization, and management dual-optimized for Google rankings (E-E-A-T, the 2026 core updates) and AI citations (GEO/AEO), spanning writing, rewriting and freshness, SERP-informed briefs and outlines, editorial calendars and strategy, semantic topic clusters, schema and internal linking, multilingual publishing, the FLOW framework, factchecking, personas, distribution, and the blog delivery contract, grounded in the claude-blog skill",
  "generic_only": false,
  "last_verified": "2026-08-25",
  "release_note": "Blog post, topic cluster, and GEO citation audit JSON adapter paths are implemented, CLI-wired, and covered by subprocess tests. Market-ready verification passed after all 118 due source-ledger entries received explicit content, manual, or corrected review decisions on 2026-08-25.",
  "raw_input_types": [
    "blog-post input JSON using schemas/blog-post-input.schema.json",
    "Markdown body supplied through blog-post input JSON",
    "HTML body supplied through blog-post input JSON",
    "topic-cluster plan JSON using schemas/topic-cluster-input.schema.json",
    "GEO citation audit JSON using schemas/geo-citation-audit-input.schema.json"
  ],
  "rules": {
    "domain_adapted_requires": [
      "one real domain importer or ingestion path",
      "one domain-specific synthesis module",
      "one report renderer",
      "one fixture per supported input type",
      "tests for valid input, malformed input, rendering, credentials boundary, deterministic output, and citation coverage",
      "URL, local path, HTML sanitization, symlink, SSRF, and secret-handling gates"
    ]
  },
  "input_schemas": [
    {
      "name": "blog-post-input",
      "path": "schemas/blog-post-input.schema.json",
      "status": "implemented",
      "planned": false,
      "enforces": [
        "required title, url, target_keyword, and locale",
        "one of body_markdown or body_html",
        "HTTP(S) URL patterns",
        "ISO date or date-time patterns"
      ]
    },
    {
      "name": "topic-cluster-input",
      "path": "schemas/topic-cluster-input.schema.json",
      "status": "implemented",
      "planned": false,
      "enforces": [
        "required cluster_name, primary_topic, locale, hub, and spokes",
        "at least two spoke pages",
        "HTTP(S) URLs for hub, spokes, and existing links",
        "locale pattern and unique spoke IDs"
      ]
    },
    {
      "name": "geo-citation-audit-input",
      "path": "schemas/geo-citation-audit-input.schema.json",
      "status": "implemented",
      "planned": false,
      "enforces": [
        "required audit_name, URL, title, locale, target queries, passages, and page signals",
        "at least one target query and one passage",
        "HTTP(S) URLs for page and passage citations",
        "boolean page signals and ISO citation dates"
      ]
    }
  ],
  "importers": [
    {
      "name": "ingest_blog_input",
